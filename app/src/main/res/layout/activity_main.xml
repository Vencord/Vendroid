<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <!-- The WebView is added here from code: it outlives the activity so Discord stays connected in the background -->
    <FrameLayout
        android:id="@+id/web_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Loading screen -->
    <LinearLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:id="@+id/logo_image"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_pixel_frame"
            android:contentDescription="@string/app_name"
            android:padding="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/pixel_avatar" />

        <dev.vendicated.vencord.PixelLogoView
            android:id="@+id/logo_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:fontFamily="monospace"
            android:id="@+id/tagline_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.25"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <dev.vendicated.vencord.PixelBarView
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="36dp" />

        <TextView android:fontFamily="monospace"
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button android:fontFamily="monospace"
            android:id="@+id/retry_button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn_primary"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Floating button: draggable, always on top, so a problem can be reported even before logging in -->
    <ImageView
        android:id="@+id/fab"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="top|left"
        android:alpha="0.9"
        android:background="@drawable/bg_fab"
        android:contentDescription="@string/fab_description"
        android:elevation="10dp"
        android:padding="3dp"
        android:scaleType="fitXY"
        android:src="@mipmap/ic_launcher" />

    <!-- Hub: messages log / report a problem / about + settings -->
    <FrameLayout
        android:id="@+id/hub_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/hub_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hub_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView android:fontFamily="monospace"
                    android:id="@+id/hub_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView android:fontFamily="monospace"
                    android:id="@+id/tab_messages"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tab_messages"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView android:fontFamily="monospace"
                    android:id="@+id/tab_report"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tab_report"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <TextView android:fontFamily="monospace"
                    android:id="@+id/tab_about"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/tab_about"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1">

                <!-- Tab 1: deleted / edited messages -->
                <LinearLayout
                    android:id="@+id/page_messages"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/chip_all"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/chip_deleted"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/chip_deleted"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/chip_edited"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/chip_edited"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/msg_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_btn_danger"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/clear"
                            android:textColor="@color/danger"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView android:fontFamily="monospace"
                        android:id="@+id/msg_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1">

                        <ListView
                            android:id="@+id/msg_list"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:divider="@android:color/transparent"
                            android:dividerHeight="8dp"
                            android:scrollbars="none" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/msg_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:padding="24dp"
                            android:text="@string/messages_empty"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Tab 2: report a problem -->
                <ScrollView
                    android:id="@+id/page_report"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:fontFamily="monospace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/report_intro"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <EditText android:fontFamily="monospace"
                            android:id="@+id/report_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_input"
                            android:gravity="top|start"
                            android:hint="@string/report_description_hint"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="4"
                            android:padding="12dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#6B6B6B"
                            android:textSize="14sp" />

                        <EditText android:fontFamily="monospace"
                            android:id="@+id/report_contact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_input"
                            android:hint="@string/report_contact_hint"
                            android:inputType="text"
                            android:maxLines="1"
                            android:padding="12dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="#6B6B6B"
                            android:textSize="14sp" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/report_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <Button android:fontFamily="monospace"
                                android:id="@+id/report_send"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_btn_primary"
                                android:text="@string/report_send"
                                android:textAllCaps="false"
                                android:textColor="#000000"
                                android:textSize="14sp" />


                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>

                <!-- Tab 3: developer / contact + settings -->
                <ScrollView
                    android:id="@+id/page_about"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:fontFamily="monospace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_dev_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/about_dev_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp" />

                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_tiktok"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_btn_tiktok"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_instagram"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_instagram"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_discord"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_discord"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <TextView android:fontFamily="monospace"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/about_settings"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_background"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_secondary"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />



                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_battery"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_secondary"
                            android:text="@string/about_battery"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <Button android:fontFamily="monospace"
                            android:id="@+id/about_update"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_secondary"
                            android:text="@string/about_update"
                            android:textAllCaps="false"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView android:fontFamily="monospace"
                            android:id="@+id/about_version"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center"
                            android:textColor="#6B6B6B"
                            android:textSize="11sp" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Access gate: nothing is loaded or injected until a valid code has been entered -->
    <ScrollView
        android:id="@+id/lock_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:elevation="20dp"
        android:fillViewport="true"
        android:focusable="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingTop="56dp"
            android:paddingEnd="32dp"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_pixel_frame"
                android:contentDescription="@string/app_name"
                android:padding="4dp"
                android:scaleType="fitXY"
                android:src="@drawable/pixel_avatar" />

            <dev.vendicated.vencord.PixelLogoView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="@string/lock_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lock_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/lock_ended"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/lock_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="@string/lock_hint"
                android:inputType="textVisiblePassword|textNoSuggestions"
                android:maxLines="1"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="#6B6B6B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lock_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/lock_activate"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_btn_primary"
                android:fontFamily="monospace"
                android:text="@string/lock_activate"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="@string/lock_request"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/lock_tiktok"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_tiktok"
                android:fontFamily="monospace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/lock_instagram"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_instagram"
                android:fontFamily="monospace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/lock_discord"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_discord"
                android:fontFamily="monospace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
